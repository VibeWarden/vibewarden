# Binaries
/bin/
/vibewarden
/vibew
*.exe

# Environment and secrets
.env
.env.*
!.env.example
!.env.*.example

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Go
vendor/

# npm distribution wrapper (npm/) — publish-time copies and local install state.
# npm/vendor/ (the downloaded binary) is already covered by the `vendor/` rule above.
npm/node_modules/
npm/LICENSE
npm/*.tgz

# Test artifacts
coverage.out
*.cov.out
domain_app_cov.out
coverage.html
.venv/

# Local dev JWKS keys — auto-generated by VibeWarden, must not be committed
**/.vibewarden/dev-keys/
/site/

# Release hook output (emit-kickoff-artifacts.sh) — never committed, uploaded as GitHub Release assets
/release-artifacts/
