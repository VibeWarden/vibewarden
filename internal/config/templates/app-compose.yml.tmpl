# docker-compose.yml — {{ .ProjectName }} (managed by VibeWarden)
# Generated by vibew deploy — do not edit manually.
#
# This compose file runs the application container for the {{ .ProjectName }} site.
# It connects to the shared vibewarden-multiapp network so the sidecar can
# reverse-proxy traffic to it.

services:
  {{ .ProjectName }}-app:
    container_name: vibewarden-{{ .ProjectName }}-app
    restart: unless-stopped
{{- if .AppBuild }}
    build:
      context: .
{{- else if .AppImage }}
    image: {{ .AppImage }}
{{- end }}
{{- if len .AppEnvironment }}
    environment:
{{- range $key, $value := .AppEnvironment }}
      - {{ $key }}={{ $value }}
{{- end }}
{{- end }}
{{- if ne .AppHealthcheck "none" }}
    healthcheck:
      test:
        - CMD-SHELL
        - {{ if .AppHealthcheck }}{{ .AppHealthcheck }}{{ else }}{{ healthcheckCmd .AppLanguage .UpstreamPort }}{{ end }}
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
{{- end }}
    networks:
      - vibewarden-multiapp

networks:
  vibewarden-multiapp:
    external: true
