# docker-compose.yml — VibeWarden sidecar (multi-app mode)
# Generated by vibew bundle — do not edit manually.
#
# This compose file manages the shared VibeWarden sidecar that reverse-proxies
# all sites defined under ~/vibewarden/sites/. Each site has its own compose
# file in sites/<project>/docker-compose.yml.

services:
  vibewarden:
    image: ghcr.io/vibewarden/vibewarden:latest
    container_name: vibewarden-sidecar
    restart: unless-stopped
    command: ["serve", "--config", "/etc/vibewarden/global.yaml"]
    ports:
      - "{{ .ListenPort }}:{{ .ListenPort }}"
      - "80:80"
    dns:
      - "1.1.1.1"
      - "8.8.8.8"
    volumes:
      - ./global.yaml:/etc/vibewarden/global.yaml:ro
      - ../sites:/etc/vibewarden/sites:ro
      - vibewarden-data:/root/.local/share/caddy
    networks:
      - vibewarden-multiapp

networks:
  vibewarden-multiapp:
    external: true

volumes:
  vibewarden-data:
    # Named volume persists Let's Encrypt certificates across deploys.
    # Never use "docker compose down -v" in production — it deletes certs
    # and may trigger ACME rate limits on re-issuance.
