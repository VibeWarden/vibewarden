# yaml-language-server: $schema=https://vibewarden.dev/schema/v1/config.json
# vibewarden.production.yaml -- Production overrides for VibeWarden
# Generated by `vibew init`. Only uncommented values override vibewarden.yaml.
# `vibew bundle` deep-merges this file on top of vibewarden.yaml when it
# writes the self-contained deploy artifact under .vibewarden/bundle/.
#
# NEVER put production-only config in vibewarden.yaml.
# vibewarden.yaml is your local dev config. This file is for production.
# Full reference: https://vibewarden.dev/docs/config

# --- Production defaults (active) ---

server:
  port: 443

tls:
  enabled: true
  provider: "letsencrypt"
