# yaml-language-server: $schema=https://vibewarden.dev/schema/v1/config.json
# vibewarden.production.yaml — production overrides merged on top of vibewarden.yaml.
# See https://vibewarden.dev/docs/examples/production-overrides for canonical override patterns,
# and vibewarden.reference.yaml for the full config schema.

server:
  port: 443

deploy:
  # Target platform for `vibew bundle`. The bundle aborts if the image arch
  # does not match. Hetzner and most cloud VMs are linux/amd64.
  target_platform: linux/amd64
  # host: user@host  # SSH target for `vibew bundle` deploy commands.
                     # Resolves into the printed deploy block when set.
                     # Accepts a literal user@host or an alias from ~/.ssh/config.

